# Android build environment with pinned toolchain versions for AndFlmsg.
#
# The wrapper builds this image automatically and stamps it so it is not
# rebuilt on every run (auto-detects Podman or Docker):
#   ./scripts/container-build.sh :andFlmsg:assembleDebug
#
# If you build the image manually, add the stamp label shown in
# container/README.md so the wrapper reuses it.

ARG ANDROID_CMDLINE_TOOLS=15859902
ARG ANDROID_CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
ARG ANDROID_PLATFORM=android-33
ARG ANDROID_BUILD_TOOLS=33.0.2
ARG ANDROID_NDK=21.4.7075529

# The Android command-line tools require JDK 17, so install the SDK in a
# separate stage. The final image uses JDK 11, which is compatible with the
# project's Gradle 7.5.1 wrapper and AGP 7.4.2.
FROM docker.io/library/eclipse-temurin:17-jdk-jammy@sha256:96ac8197b2cbc2bb0f9fbcbf91dbb0015f43b3c76a1cb351892da12e7bb91bed AS sdk

ARG ANDROID_CMDLINE_TOOLS
ARG ANDROID_CMDLINE_TOOLS_SHA256
ARG ANDROID_PLATFORM
ARG ANDROID_BUILD_TOOLS
ARG ANDROID_NDK

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p "${ANDROID_HOME}/cmdline-tools" \
    && curl -fsSL \
        "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS}_latest.zip" \
        -o /tmp/cmdline-tools.zip \
    && echo "${ANDROID_CMDLINE_TOOLS_SHA256}  /tmp/cmdline-tools.zip" | sha256sum -c - \
    && unzip -q /tmp/cmdline-tools.zip -d "${ANDROID_HOME}/cmdline-tools" \
    && mv "${ANDROID_HOME}/cmdline-tools/cmdline-tools" \
        "${ANDROID_HOME}/cmdline-tools/latest" \
    && rm /tmp/cmdline-tools.zip

ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"

RUN yes | sdkmanager --sdk_root="${ANDROID_HOME}" --licenses >/dev/null \
    && sdkmanager --sdk_root="${ANDROID_HOME}" --install \
        "platform-tools" \
        "platforms;${ANDROID_PLATFORM}" \
        "build-tools;${ANDROID_BUILD_TOOLS}" \
        "ndk;${ANDROID_NDK}" \
    && rm -rf "${HOME}/.android/cache"

FROM docker.io/library/eclipse-temurin:11-jdk-jammy@sha256:56baf52be9510d77b5eaca50f3b0d5b4553ceffe6f98a52d4c82b5f4c73c5b82

ARG ANDROID_NDK

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_NDK_HOME=/opt/android-sdk/ndk/${ANDROID_NDK} \
    GRADLE_USER_HOME=/root/.gradle

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        file \
        git \
        make \
    && rm -rf /var/lib/apt/lists/*

COPY --from=sdk /opt/android-sdk /opt/android-sdk

ENV PATH="${ANDROID_NDK_HOME}:${ANDROID_HOME}/platform-tools:${PATH}"

WORKDIR /workspace

CMD ["/bin/bash"]
